{
  "name": "weatherv3",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "postinstall": "svelte-kit sync || echo ''",
